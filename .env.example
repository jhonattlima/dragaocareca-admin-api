NODE_ENV=development
PORT=3000
SQLITE_PATH=data/database/dragaocareca-admin.sqlite
SQLITE_RESET=false
GOOGLE_CLIENT_ID=
JWT_SECRET=
JWT_EXPIRES_IN=12h
ALLOWED_GOOGLE_EMAILS=
AUTH_BYPASS=false

# Episode transcription
EPISODE_TRANSCRIPTION_ENABLED=false
# internal uses whisper.cpp; gemini uploads the audio to the Gemini Files API; groq uses Groq Whisper.
# Gemini is the automatic provider; the UI fallback uses faster-whisper explicitly.
EPISODE_TRANSCRIPTION_PROVIDER=gemini
EPISODE_TRANSCRIPTION_COMMAND=whisper-cli
EPISODE_TRANSCRIPTION_MODEL_PATH=
EPISODE_TRANSCRIPTION_WHISPER_THREADS=4
EPISODE_TRANSCRIPTION_FASTER_WHISPER_PYTHON=python3
EPISODE_TRANSCRIPTION_FASTER_WHISPER_SCRIPT=scripts/faster_whisper_transcribe.py
EPISODE_TRANSCRIPTION_FASTER_WHISPER_MODEL=small
EPISODE_TRANSCRIPTION_FASTER_WHISPER_DEVICE=cpu
EPISODE_TRANSCRIPTION_FASTER_WHISPER_COMPUTE_TYPE=int8
EPISODE_TRANSCRIPTION_LANGUAGE=pt
EPISODE_TRANSCRIPTION_TIMEOUT_MS=7200000
EPISODE_TRANSCRIPTION_POLL_INTERVAL_MS=300000
EPISODE_TRANSCRIPTION_GEMINI_MODEL=gemini-3.6-flash
EPISODE_TRANSCRIPTION_GEMINI_MAX_OUTPUT_TOKENS=32768
EPISODE_TRANSCRIPTION_GEMINI_THINKING_LEVEL=minimal
EPISODE_TRANSCRIPTION_GROQ_MODEL=whisper-large-v3-turbo

# Episode summary suggestion
EPISODE_SUMMARY_ENABLED=false
# Hashtag authoring uses this provider for candidate generation.
EPISODE_SUMMARY_PROVIDER=groq
# Summary generation tries this provider first, then falls back to Groq.
EPISODE_SUMMARY_PRIMARY_PROVIDER=gemini
EPISODE_SUMMARY_COMMAND=llama-cli
EPISODE_SUMMARY_MODEL_PATH=
EPISODE_SUMMARY_CONTEXT_SIZE=8192
EPISODE_SUMMARY_MAX_TOKENS=700
EPISODE_SUMMARY_TIMEOUT_MS=900000
EPISODE_SUMMARY_PROMPT_VERSION=6

GEMINI_API_KEY=
EPISODE_SUMMARY_GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EPISODE_SUMMARY_GEMINI_THINKING_LEVEL=low
GROQ_API_KEY=
EPISODE_SUMMARY_GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MIN_INTERVAL_MS=60000
GROQ_TOKENS_PER_MINUTE=8000
GROQ_DAILY_TOKEN_LIMIT=200000
GROQ_RATE_LIMIT_RETRIES=1

# Spotify creator analytics connector
SPOTIFY_METRICS_ENABLED=false
SPOTIFY_PODCAST_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_SP_DC=
SPOTIFY_SP_KEY=
SPOTIFY_METRICS_BASE_URL=https://generic.wg.spotify.com/podcasters/v0
SPOTIFY_METRICS_TIMEOUT_MS=15000
SPOTIFY_METRICS_SAMPLE_INTERVAL_MS=86400000

# Spotify episode-ID resolver (separate from creator analytics)
SPOTIFY_EPISODE_RESOLVER_ENABLED=false
SPOTIFY_EPISODE_SHOW_ID=
SPOTIFY_EPISODE_CLIENT_ID=
SPOTIFY_EPISODE_CLIENT_SECRET=

# YouTube creator analytics connector
YOUTUBE_METRICS_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_ANALYTICS_BASE_URL=https://youtubeanalytics.googleapis.com/v2
YOUTUBE_DATA_BASE_URL=https://youtube.googleapis.com/youtube/v3
YOUTUBE_METRICS_TIME_ZONE=America/Sao_Paulo
YOUTUBE_METRICS_TIMEOUT_MS=15000
YOUTUBE_METRICS_SAMPLE_INTERVAL_MS=86400000

# Hashtag authoring uses approximate YouTube search counts. Fresh cache hits do not consume quota.
YOUTUBE_HASHTAG_AUTHORING_ENABLED=false
YOUTUBE_HASHTAG_GEMINI_MODEL=gemini-3.6-flash
YOUTUBE_HASHTAG_GROQ_MODEL=openai/gpt-oss-120b
# Gemini is tried first; Groq is used automatically if Gemini fails.
YOUTUBE_HASHTAG_PRIMARY_PROVIDER=gemini
YOUTUBE_HASHTAG_PROVIDER=groq
YOUTUBE_HASHTAG_GEMINI_PROMPT_VERSION=1
# Fresh successful and zero-result normalized lookups remain reusable for one hour.
YOUTUBE_HASHTAG_CACHE_SUCCESS_TTL_MS=3600000
YOUTUBE_HASHTAG_CACHE_ZERO_RESULT_TTL_MS=3600000
# Exactly one server-side lookup lane is permitted.
YOUTUBE_HASHTAG_LOOKUP_LANE_COUNT=1
# Pacific-time quota-day reservations are fixed and non-borrowable: automatic work cannot use
# manual capacity, and manual work cannot use automatic capacity.
YOUTUBE_HASHTAG_AUTOMATIC_DAILY_CALLS=90
YOUTUBE_HASHTAG_MANUAL_DAILY_CALLS=10
YOUTUBE_HASHTAG_REGION_CODE=BR
YOUTUBE_HASHTAG_RELEVANCE_LANGUAGE=pt
YOUTUBE_HASHTAG_REQUEST_TIMEOUT_MS=15000
YOUTUBE_HASHTAG_RETRY_DELAY_1_MS=60000
YOUTUBE_HASHTAG_RETRY_DELAY_2_MS=300000
YOUTUBE_HASHTAG_RETRY_DELAY_3_MS=900000
YOUTUBE_HASHTAG_RETRY_DELAY_4_MS=3600000

# Private YouTube trailer-video jobs stay disabled until the operator completes
# the documented OAuth/channel readiness checkpoint. They reuse the credentials above.
YOUTUBE_TRAILER_JOB_ENABLED=false
YOUTUBE_TRAILER_JOB_PROVIDER_TIMEOUT_MS=30000
YOUTUBE_TRAILER_JOB_PROCESSING_POLL_INTERVAL_MS=60000
YOUTUBE_TRAILER_JOB_RETRY_INITIAL_DELAY_MS=60000
YOUTUBE_TRAILER_JOB_RETRY_MAX_DELAY_MS=900000
YOUTUBE_TRAILER_JOB_RETRY_ATTEMPTS=5
YOUTUBE_TRAILER_JOB_WORKER_COUNT=1
# Bounded to at most 33554432 bytes by server configuration.
YOUTUBE_TRAILER_JOB_CHUNK_BYTES=8388608
# Explicit publication stays disabled until the blocking OAuth/channel checkpoint passes.
YOUTUBE_TRAILER_PUBLICATION_ENABLED=false
# Fixed server-owned publication targets; do not replace these with browser input.
# Channel: Dragao Careca Oficial (UCq-TjauoYJrr3po121gA6iw)
# Playlist: PLlsWY6yTsd_EsW1HlbXZs3Sz72o42376t
# Required OAuth scopes: youtube.upload and youtube.force-ssl.
YOUTUBE_TRAILER_RETENTION_KEEP_COUNT=12

# Telegram launch notifications
# Required for the bot to run:
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=-1001234567890
# Optional:
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_POLL_INTERVAL_MS=300000
TELEGRAM_YTDLP_COMMAND=yt-dlp

MEDIA_STORAGE_ROOT=data/media
# Maximum accepted final trailer-video upload size in bytes. Must be a positive integer; defaults to 524288000 (500 MiB).
EPISODE_TRAILER_VIDEO_MAX_BYTES=524288000
MEDIA_BACKUP_ROOT=data/media/backups
MEDIA_EPISODES_DIR=data/media/episodes
MEDIA_EPISODES_STAGING_DIR=data/media/episodes/staging
MEDIA_TRAILERS_DIR=data/media/trailers
MEDIA_TRAILERS_STAGING_DIR=data/media/trailers/staging
MEDIA_COVERS_DIR=data/media/images
MEDIA_COVERS_STAGING_DIR=data/media/images/staging
MEDIA_COVERS_LOW_DIR=data/media/images/low
MEDIA_COVERS_LOW_STAGING_DIR=data/media/images/low/staging
MEDIA_BACKUP_EPISODES_DIR=data/media/backups/episodes
MEDIA_BACKUP_EPISODES_AUDIO_DIR=data/media/backups/episodes/audio
MEDIA_BACKUP_EPISODES_TRAILERS_DIR=data/media/backups/episodes/trailers
MEDIA_BACKUP_EPISODES_COVERS_DIR=data/media/backups/episodes/images
MEDIA_BACKUP_EPISODES_COVERS_LOW_DIR=data/media/backups/episodes/images/low

FEED_BASE_LINK=https://dragaocareca.com/#/episode/
FEED_AUDIO_BASE=https://www.dragaocareca.com/files/episodes/
FEED_AUDIO_TRACKER_PREFIX=https://dts.podtrac.com/redirect.mp3/
FEED_IMAGE_BASE=https://www.dragaocareca.com/files/images/
FEED_TITLE=Dragao Careca
FEED_DESCRIPTION=Dragao Careca podcast feed
FEED_SITE=https://dragaocareca.com
FEED_LANGUAGE=pt-BR
FEED_SELF_URL=https://www.feed.dragaocareca.com/
FEED_DEFAULT_IMAGE=https://www.dragaocareca.com/files/images/2026-04-10-v4.jpeg
FEED_COPYRIGHT=© Dragao Careca - 2019 ©
FEED_GENERATOR=go podcast v1.3.1 (github.com/eduncan911/podcast)
FEED_MANAGING_EDITOR=dragaocarecaoficial@gmail.com (Dragao Careca)
FEED_CATEGORY_LIST=Comedy,Games,RPG
FEED_ITUNES_AUTHOR=dragaocarecaoficial@gmail.com (Dragao Careca)
FEED_ITUNES_SUMMARY=Um podcast de entretenimento onde aventureiros contam historias e desbravam a cultura pop com muito humor, nostalgia e entrevistas curiosas.
FEED_ITUNES_SUBTITLE=Podcast sobre RPG, Filmes, Series e outros assuntos nerd.
FEED_ITUNES_EXPLICIT=no
FEED_ITUNES_TYPE=episodic
FEED_ITUNES_OWNER_NAME=Jhonatt Lima e Diego Broniszak
FEED_ITUNES_OWNER_EMAIL=dragaocarecaoficial@gmail.com
FEED_ITUNES_KEYWORDS=Entertainment,Games,Fiction
FEED_ITUNES_CATEGORY_PRIMARY=Comedy
FEED_ITUNES_CATEGORY_PRIMARY_SUB=Improv
FEED_ITUNES_CATEGORY_SECONDARY=Leisure
FEED_ITUNES_CATEGORY_SECONDARY_SUB=Games
META_APP_ID=
META_APP_SECRET=
# User token used only to discover/validate the managed Facebook Page.
META_USER_ACCESS_TOKEN=
# Page token used by every Facebook and Instagram publication request.
META_PAGE_ACCESS_TOKEN=
META_SYSTEM_USER_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_GRAPH_API_VERSION=v25.0
META_INSTAGRAM_ENABLED=false
META_FACEBOOK_REEL_ENABLED=false
SOCIAL_PUBLICATION_RETRY_POLL_INTERVAL_MS=60000
ENABLE_SOCIAL_PUBLICATION_RETRY_WORKER=false
META_PROVIDER_MEDIA_BASE_URL=https://api.dragaocareca.com/media/episodes
# Optional legacy fixture override; 0 enables the released-episode rule.
META_PROVIDER_MEDIA_EPISODE_ID=0
META_PROVIDER_MEDIA_EXPOSURE_ENABLED=false
PROMOTION_ENABLED=false
PROMOTION_BOT_URL=http://bot:8080/internal/promotions
LAUNCH_NOTIFICATION_BOT_URL=http://bot:8080/internal/launch-notifications
PROMOTION_LEGACY_LAUNCH_ENABLED=true
